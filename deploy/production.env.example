# Hosted single-organisation mode. Set these in the platform's secret manager.
CANOPY_RUNTIME=production
CANOPY_PUBLIC_ORIGIN=https://canopy.example.com
CANOPY_WORKOS_ORG_ID=org_replace_with_your_org_id
CANOPY_ADMIN_USER_ID=user_replace_with_your_admin_id
WORKOS_CLIENT_ID=client_replace_with_your_client_id
WORKOS_API_KEY=replace_in_secret_manager
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
WORKOS_COOKIE_PASSWORD=replace_in_secret_manager
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
CANOPY_CSRF_SECRET=replace_in_secret_manager
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
MUBIT_API_KEY=replace_in_secret_manager
MUBIT_MODEL=gpt-4.1-mini
# The bundled policy is fictional demo material. Replace it with an approved policy later.
CANOPY_POLICY_PATH=/app/canopy_app/sample_policy.json
